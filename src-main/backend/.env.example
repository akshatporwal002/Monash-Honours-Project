APP_NAME="QuantumLearn API"
APP_ENV="development"
API_PREFIX="/api/v1"
DATABASE_URL="sqlite:///./quantumlearn.db"
FRONTEND_ORIGIN="http://localhost:5173"
# Production requires a unique value of at least 32 bytes, distinct from the
# learning-event pseudonym secret.
SESSION_SECRET_KEY="development-only-session-secret-change-me"
SESSION_TTL_MINUTES=60
SESSION_COOKIE_NAME="quantumlearn_session"
SESSION_COOKIE_SECURE=false
# Keep interactive API documentation disabled in production unless explicitly approved.
API_DOCS_ENABLED=true
# Comma-separated explicit origins; never use '*' with credentials.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
CSRF_ENABLED=true
CSRF_HEADER_NAME="X-CSRF-Token"
CSRF_COOKIE_NAME=ql_csrf
RATE_LIMIT_ENABLED=true
FEEDBACK_JOB_LEASE_SECONDS=300
PROVIDER_TIMEOUT_SECONDS=60
MAX_INFRASTRUCTURE_ATTEMPTS=3
RESEARCH_EXPORT_ROW_LIMIT=100000
RESEARCH_EXPORT_BATCH_SIZE=1000
MAX_REQUEST_BODY_BYTES=22020096
WORKER_STALE_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_HEARTBEAT_SECONDS=30
# Offline-first MVP worker; replace only with a reviewed integration factory.
WORKER_ADAPTER_FACTORY="app.worker:build_offline_worker_adapters"
# Production readiness requires this to be at least 32 bytes.
LEARNING_EVENT_PSEUDONYM_SECRET=replace-with-at-least-32-random-characters
# Research remains disabled unless an eligibility/consent adapter is configured.
RESEARCH_ENABLED=false
# Set true only after all production-owned identity, content, worker, and roster adapters are wired.
PRODUCTION_ADAPTERS_READY=false
LLM_API_KEY=
LLM_API_BASE_URL="https://api.openai.com/v1"
LLM_PROVIDER="openai"
# Configure a structured-output capable model; keep source code provider-neutral.
LLM_MODEL=
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
