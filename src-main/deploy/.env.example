# Image and host binding. Keep BIND_ADDRESS on loopback when a host TLS proxy is used.
IMAGE_TAG=local
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
DATA_VOLUME_NAME=quantumlearn_data
# Override both paths together when validating an isolated restored volume.
DATABASE_URL=sqlite:////data/quantumlearn.db
RAG_UPLOAD_DIR=/data/uploads
PUBLIC_ORIGIN=http://localhost:8080

# Local defaults. compose.hosted.yaml forces production, secure cookies, and no demo bootstrap.
APP_ENV=development
API_DOCS_ENABLED=true
SESSION_COOKIE_SECURE=false
BOOTSTRAP_DEMO=true
MIGRATE_ON_START=true

# Empty placeholders: hosted Compose refuses to start until both are set.
SESSION_SECRET_KEY=
LEARNING_EVENT_PSEUDONYM_SECRET=

# The MVP runs deterministic local feedback when these are blank.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_MODEL=
# Leave monetary values absent until actual budget/pricing records are supplied.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
LLM_BUDGET_ID=
LLM_BUDGET_POLICY_VERSION=
LLM_BUDGET_LIMIT=
LLM_COST_CURRENCY=
LLM_PRICING_VERSION=
LLM_PRICING_PROVIDER=
LLM_PRICING_MODEL=
LLM_PRICING_BASE_URL=
LLM_MAX_INPUT_TOKENS=32768
LLM_MAX_OUTPUT_TOKENS=4096

# The built-in worker recovers feedback jobs and maintains readiness without a
# network model. Replace the factory only when deploying reviewed integrations.
WORKER_ADAPTER_FACTORY=app.worker:build_offline_worker_adapters
RESEARCH_ENABLED=false
PRODUCTION_ADAPTERS_READY=false

# Bound uploads fit beneath the API request limit, including multipart overhead.
RAG_MAX_FILE_BYTES=20971520
MAX_REQUEST_BODY_BYTES=22020096

# New intake stays quarantined until the approved scanner policy and fresh
# signatures are provisioned. Add compose.scanner.yaml to mount the signature volume.
MATERIAL_SCAN_POLICY=disabled
MATERIAL_SCAN_POLICY_VERSION=
MATERIAL_CLAMSCAN_PATH=/usr/bin/clamscan
MATERIAL_SCAN_TIMEOUT_SECONDS=60
MATERIAL_SCAN_DATABASE_MAX_AGE_DAYS=7
CLAMAV_SIGNATURE_VOLUME=
